{
  "name": "botvisitas",
  "version": "2.0.0",
  "description": "Bot multi-dispositivo de visitas automatizadas (Puppeteer)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dashboard": "node src/dashboard/server.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "start:dry": "node -e \"process.env.STRATEGY='dryRun';require('./src/index.js')\"",
    "start:headed": "node -e \"process.env.HEADLESS='false';require('./src/index.js')\"",
    "test:server": "node scripts/test-server.js",
    "test:egress0": "node scripts/teste0-native-egress.js",
    "tuxler:rotate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tuxler-rotate.ps1",
    "tuxler:check": "node scripts/tuxler-check.js",
    "tuxler:check:quick": "node scripts/tuxler-check.js --quick",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "stop:force": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "browsers:install": "npx puppeteer browsers install chrome",
    "postinstall": "npx puppeteer browsers install chrome || true",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f bot",
    "docker:restart": "docker compose restart bot",
    "test": "node -e \"const c=require('./src/config').loadConfig(); const a=require('./src/core/proxy').getProxyLaunchArgs(c,null); if(!Array.isArray(c.targetUrls)||c.targetUrls.length!==0) process.exit(2); if(!['native','tuxler','tuxler-system','http-pool'].includes(c.egress)) process.exit(3); if(c.egress==='native'&&!a.includes('--no-proxy-server')) process.exit(4); if(c.egress==='tuxler-system'&&a.length!==0) process.exit(5); console.log('config ok egress='+c.egress+' args='+JSON.stringify(a));\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "puppeteer",
    "bot",
    "visits",
    "dashboard"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "puppeteer": "^21.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
