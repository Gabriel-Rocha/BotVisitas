# Dependências
node_modules/

# Ambiente local / secrets (nunca subir)
.env
.env.local
.env.*.local
!.env.example

# Config e dados locais
config/local.*
config/*.local.json
config/secrets.*
config/schedule.json
config/visit-metrics.jsonl
config/proxy-pool.json
*.pem
*.key
credentials*.json

# Perfis Chromium persistentes (1 worker = 1 identidade)
profiles/

# Runtime / logs
logs/*
!logs/.gitkeep
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Puppeteer / Chromium cache local
.local-chromium/
.puppeteer_cache/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Docker (artefatos locais raros)
*.dockerignore.local

# Editores / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Ferramentas locais (BMAD / assistentes) — ambiente local, não versionar
.claude/
.cursor/_bmad/
_bmad/

# Testes / coverage
coverage/
.nyc_output/

# Builds / temporários
dist/
build/
tmp/
temp/
*.tmp
web/dist/
web/node_modules/
