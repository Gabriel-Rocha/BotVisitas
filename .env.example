# Copie para .env e ajuste. Nunca commite o .env.

STRATEGY=directLink
HEADLESS=true
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# === EGRESS (flag mestre) ===
# tuxler-system = herda proxy do Windows (Tuxler no app) — default / estilo v1
# native        = placa de rede + --no-proxy-server
# tuxler        = SOCKS explícito 127.0.0.1:23321 (legado)
# http-pool     = proxy HTTP externo
EGRESS=tuxler-system

NAVIGATION_TIMEOUT_MS=30000
DEFAULT_TIMEOUT_MS=30000

# Jitter legado. Cadência real = VISIT_* abaixo.
INTERVAL_MIN_SEC=0
INTERVAL_MAX_SEC=0

# === Cadência com espaçamento ===
VISIT_SERIAL=true
VISIT_GAP_MIN_SEC=8
VISIT_GAP_MAX_SEC=25
BURST_EVERY_HITS=200
BURST_PAUSE_MIN_MIN=15
BURST_PAUSE_MAX_MIN=45
HIT_SOFT_CAP_DAY=1000
HIT_SOFT_PAUSE_HOURS=1
HIT_HARD_CAP_DAY=2500
HIT_ACTIVE_HOUR_START=8
HIT_ACTIVE_HOUR_END=23
POPUP_LINGER_MS=15000
IP_CHECK_EVERY_VISITS=10
ZERO_CLICK_CHANCE=0.25

BROWSER_RESTART_EVERY=20
CHROME_PROCESS_LIMIT=1
MEMORY_WARN_PCT=0.82
MEMORY_CRITICAL_PCT=0.90

BROWSE_PAGES_MIN=0
BROWSE_PAGES_MAX=0
INCLUDE_REFERRER=true
ENGAGE_ENABLED=true
ENGAGE_CLICKS_MIN=0
ENGAGE_CLICKS_MAX=1
MAX_CLICKS_PER_PAGE=1
CLICK_SELECTOR=
VISIT_MAX_SEC=60
VISIT_RETRY_ON_DEAD_END=1
ENGAGE_MAX_MS=25000
CLICK_MODE=hybrid
ENGAGE_REQUIRE_URL_CHANGE=false

BANDWIDTH_SAVER=light

# Vários browsers; visitas serializadas (1 por vez)
CONCURRENCY=8
DEVICE_MIX=desktop:4,mobile:4
WORKER_STAGGER_MS=800

VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Tuxler no app → proxy Windows. Em tuxler-system o bot NÃO usa --proxy-server.
TUXLER_ENABLED=false
TUXLER_REQUIRE_ACTIVE=false
TUXLER_EXE=C:\Program Files (x86)\tuxlerVPN\tuxlerVPN.exe
TUXLER_HELPER_EXE=C:\Program Files (x86)\tuxlerVPN\ExtensionHelperAppHelperTuxler.exe
TUXLER_ROTATE_MODE=skip

PROXY_COUNTRIES=

STEALTH_GEO_TZ=true
STEALTH_TIMEZONE=America/Sao_Paulo
STEALTH_LOCALE=pt-BR

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_TOKEN=

TESTPAGE_PORT=0

POSTGRES_DB=botvisitas
POSTGRES_USER=botvisitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
SNAPSHOT_INTERVAL_SEC=30

LOG_LEVEL=info
