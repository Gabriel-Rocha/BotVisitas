# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=directLink

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Chrome/Chromium do sistema (vazio = Chromium do Puppeteer)
# No Docker o compose força /usr/bin/chromium automaticamente.
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=30000
DEFAULT_TIMEOUT_MS=30000

# Recicla o Chromium a cada N visitas (ok+erro). 0 = nunca. Com 12 workers use 8–12.
BROWSER_RESTART_EVERY=10
CHROME_PROCESS_LIMIT=1
# Worker sem nenhuma iteração por N segundos = travado: mata o Chromium e reabre
# Use ~2x VISIT_MAX_SEC para reagir rápido sem cortar visita legítima
WORKER_STALL_SEC=120
MEMORY_WARN_PCT=0.82
MEMORY_CRITICAL_PCT=0.90

# Intervalo entre visitas (0 = máximo throughput)
INTERVAL_MIN_SEC=0
INTERVAL_MAX_SEC=1

# Após a entrada: links extras (0 = só landing — mais impressões/hora)
BROWSE_PAGES_MIN=0
BROWSE_PAGES_MAX=0
# false = sem warmup Google (ganha 10–20s por visita)
INCLUDE_REFERRER=false
ENGAGE_ENABLED=true
ENGAGE_CLICKS_MIN=1
ENGAGE_CLICKS_MAX=1
MAX_CLICKS_PER_PAGE=1
CLICK_SELECTOR=
VISIT_MAX_SEC=35
VISIT_RETRY_ON_DEAD_END=0
ENGAGE_MAX_MS=10000
# engage = CTA/ads | hybrid = centro se URL mudar | legacy = só centro
CLICK_MODE=engage
ENGAGE_REQUIRE_URL_CHANGE=true

# Dwell curto = mais volume (ainda dá tempo do ad pintar)
BROWSE_DWELL_MIN_SEC=2
BROWSE_DWELL_MAX_SEC=3
BROWSE_DWELL_TAIL_MIN_SEC=1
BROWSE_DWELL_TAIL_MAX_SEC=2

# Economia de banda: off | light | aggressive
BANDWIDTH_SAVER=light

# Workers paralelos — cada um com browser + device próprio (mobile/desktop independentes)
CONCURRENCY=4
DEVICE_MIX=desktop:2,mobile:2
# Painel: 1 slot = device (+ país opcional). Ex.: desktop,mobile,desktop,mobile
# WORKER_SLOTS=desktop,mobile,desktop,mobile
WORKER_STAGGER_MS=800

# Viewport fallback
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# === Egress: TuxlerVPN residencial gratuito (Windows) ===
# 1 SOCKS por PC — NÃO dá 12 IPs paralelos. Para 12 workers reais use PROXY_ENABLED abaixo.
TUXLER_ENABLED=true
TUXLER_EXE=C:\Program Files (x86)\tuxlerVPN\tuxlerVPN.exe
# vazio = auto-detecta ao lado do TUXLER_EXE (ExtensionHelperAppHelperTuxler.exe)
TUXLER_HELPER_EXE=C:\Program Files (x86)\tuxlerVPN\ExtensionHelperAppHelperTuxler.exe
TUXLER_ROTATE_TIMEOUT_MS=15000
# skip = Tuxler manual (padrão). restart | coords | uia = rotação automática.
TUXLER_ROTATE_MODE=skip
TUXLER_CLICK_X=0.50
TUXLER_CLICK_Y=0.68
# Clique no botao "Activate" apos restart do helper (ajuste se errar o alvo)
TUXLER_ACTIVATE_X=0.50
TUXLER_ACTIVATE_Y=0.58
# Com Tuxler: se 0, o bot limita gotos a min(4, workers) no SOCKS único.
TUXLER_NAV_SLOTS=0

# === Proxy HTTP/SOCKS (1 endpoint por worker = 12 acessos paralelos) ===
# Liga isto e desliga o Tuxler automaticamente na sessão.
PROXY_ENABLED=false
# Deixe MAIOR que CONCURRENCY: os IPs extras são reserva p/ rotação em erro de rede
PROXY_MAX=20
# Ex.: http://LOGIN:SENHA@gw.dataimpulse.com:823
PROXY_SERVER=
# Lista local (uma URL por linha / vírgula). Prioridade sobre PROXY_LIST_URL / SERVER.
PROXY_LIST=
# Webshare: URL de download (host:port:user:pass). Token só no .env — não commitar.
PROXY_LIST_URL=
# Datacenter Webshare: false evita bloquear visita só por reputação ip-api
PROXY_SKIP_FLAGGED=true

# Países ISO-2 por worker (WORKER_SLOTS ou ciclo). Tuxler/proxy: geo do sticky.
PROXY_COUNTRIES=au,de,us

# Ofuscação — timezone/locale pela região do IP
STEALTH_GEO_TZ=true
# Fallback só se ip-api falhar — com Tuxler o geo real vem do IP da VPN
STEALTH_TIMEZONE=America/Caracas
STEALTH_LOCALE=es-VE

# Dashboard — npm run dashboard → http://127.0.0.1:3847
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_TOKEN=

# Sandbox Compose (testpage). 0 = Docker escolhe uma porta livre no host
TESTPAGE_PORT=0

# PostgreSQL (histórico). Não commite senhas reais.
POSTGRES_DB=botvisitas
POSTGRES_USER=botvisitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
SNAPSHOT_INTERVAL_SEC=30

LOG_LEVEL=info
