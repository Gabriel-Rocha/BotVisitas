# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=directLink

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Opcional: Chrome/Chromium do sistema (deixe vazio = Chromium do Puppeteer)
# Exemplos:
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=60000
DEFAULT_TIMEOUT_MS=30000

# Intervalo entre iterações (segundos). 0 = sem espera
INTERVAL_MIN_SEC=0
INTERVAL_MAX_SEC=0

# Reinicia o browser a cada N iterações (0 = nunca)
BROWSER_RESTART_EVERY=0

# Viewport
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Direct link — separe múltiplas URLs por vírgula
TARGET_URLS=
# 0 = 1 clique; N > 0 = aleatório entre 1 e N
MAX_CLICKS_PER_PAGE=0
INCLUDE_REFERRER=true

# Proxies
PROXY_ENABLED=false
# PROXY_SERVER=http://user:pass@host:port
PROXY_SERVER=
