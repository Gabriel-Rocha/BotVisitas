# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=dryRun

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Opcional: Chrome/Chromium do sistema (deixe vazio = Chromium do Puppeteer)
# No Docker o compose força /usr/bin/chromium automaticamente.
# Exemplos (host / Docker):
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=60000
DEFAULT_TIMEOUT_MS=30000

# Intervalo entre iterações (segundos)
INTERVAL_MIN_SEC=60
INTERVAL_MAX_SEC=900

# Reinicia o browser a cada N iterações (0 = nunca) — libera proxy e pega outro do pool
BROWSER_RESTART_EVERY=20

# Workers paralelos (cada um = 1 Chromium + 1 proxy exclusivo)
# Default 5. Com PROXY_ENABLED: teto = tamanho do pool (máx. 10).
# Atenção RAM: ~150–300MB por Chromium (5 ≈ 1GB+, 10 ≈ 2GB+).
# Se DEVICE_MIX estiver setado, a SOMA do mix manda (CONCURRENCY vira fallback).
CONCURRENCY=5

# Multi-agentes por device: desktop | mobile | tablet
# Vazio = todos desktop (usa CONCURRENCY)
# Ex.: DEVICE_MIX=desktop:2,mobile:2,tablet:1
DEVICE_MIX=

# Viewport fallback (quando sem perfil — preferir DEVICE_MIX + device-profiles.json)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Direct link — visita a URL e navega pelo site (mesmo host). Sem clique em CTA.
TARGET_URLS=
# Páginas extras após a entrada (links internos do mesmo domínio)
BROWSE_PAGES_MIN=1
BROWSE_PAGES_MAX=3
INCLUDE_REFERRER=false
# Legado (não usado pela navegação atual)
MAX_CLICKS_PER_PAGE=15
CLICK_SELECTOR=

# Receita directLink:
#   STRATEGY=directLink
#   TARGET_URLS=https://exemplo.com/smartlink
#   INCLUDE_REFERRER=false
#   INTERVAL_MIN_SEC=30  INTERVAL_MAX_SEC=60
# Fixture local opcional: npm run test:server + TARGET_URLS=http://localhost:3000
# CLICK_SELECTOR="#cta"  (aspas se começar com "#")

# Proxies — Webshare free (máx. 10). https://www.webshare.io/pricing
# NÃO é VPN: são proxies HTTP/SOCKS. Credenciais só no .env (nunca no Git).
PROXY_ENABLED=false
# Teto do plano free (hard-cap no código = 10)
PROXY_MAX=10
# roundRobin | random — troca a cada restart do browser
PROXY_ROTATE=roundRobin
# true = descarta IPs marcados proxy/hosting (free Webshare quase todo falha;
# use só com pool residencial/mobile). Default false = avisa no log e segue.
PROXY_SKIP_FLAGGED=false
# Opção A — gateway único (exemplo Webshare):
# PROXY_SERVER=http://USER:PASS@p.webshare.io:80
PROXY_SERVER=
# Opção B — até 10 proxies (CSV). Formatos:
#   http://user:pass@host:port
#   host:port:user:pass
# PROXY_LIST=1.2.3.4:80:user:pass,5.6.7.8:80:user:pass
PROXY_LIST=

# ── Ofuscação (visita humana) — docs/11-ofuscacao.md ──
# Alinha timezone/locale à região do IP (proxy.host ou egress). Default: ligado.
STEALTH_GEO_TZ=true
# Fallback quando STEALTH_GEO_TZ=false ou lookup geo falhar:
STEALTH_TIMEZONE=America/Sao_Paulo
STEALTH_LOCALE=pt-BR

# ── Dashboard UI ──
# npm run dashboard → http://127.0.0.1:3847
# Dashboard — em Docker use 0.0.0.0 (compose também força isso)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_TOKEN=

# ── PostgreSQL (histórico de runs / logs / snapshots) ──
# No Docker Compose o serviço "db" sobe com volume persistente.
# Defina POSTGRES_PASSWORD no seu .env local (nunca commite senhas reais).
POSTGRES_DB=botvisitas
POSTGRES_USER=botvisitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Local (npm run dashboard): preencha com user/senha/db do .env.
# Formato: postgres://USER:PASSWORD@127.0.0.1:5432/DB
# No container o compose monta DATABASE_URL apontando para o host "db".
DATABASE_URL=
# Intervalo dos snapshots de métricas enquanto o bot está running
SNAPSHOT_INTERVAL_SEC=10
