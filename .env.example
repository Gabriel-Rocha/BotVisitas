# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=directLink

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Chrome real = TLS/HTTP fingerprint melhor. Vazio = autodetect, senão Chromium do Puppeteer
CHROME_AUTODETECT=true
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=60000
DEFAULT_TIMEOUT_MS=30000

# Intervalo entre visitas (segundos). 0 = usa STEALTH_GAP_* (padrão humano)
INTERVAL_MIN_SEC=0
INTERVAL_MAX_SEC=0

# Reinicia o browser a cada N iterações (0 = nunca)
BROWSER_RESTART_EVERY=0

# Viewport fallback (o perfil stealth sobrescreve)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Direct link — separe múltiplas URLs por vírgula
TARGET_URLS=
# 0 = 1 clique; N > 0 = aleatório entre 1 e N
MAX_CLICKS_PER_PAGE=0
INCLUDE_REFERRER=true

# Stealth (navegador menos detectável como bot)
STEALTH=true
HUMANIZE=true
# false = cada visita é um visitante novo (contexto anônimo + cookies zerados)
# true  = um único usuário persistente (debug)
SESSION_PERSIST=false
SESSION_DIR=logs/browser-session
STEALTH_LOCALE=pt-BR
STEALTH_TIMEZONE=America/Sao_Paulo
STEALTH_GAP_MIN_MS=4000
STEALTH_GAP_MAX_MS=22000
DWELL_MIN_MS=900
DWELL_MAX_MS=4200
GEO_LAT=-23.5505
GEO_LON=-46.6333

# Proxies — reputação de IP. Sem persistência, a lista rotaciona a cada visitante
PROXY_ENABLED=false
# PROXY_SERVER=http://user:pass@host:port
# PROXY_SERVERS=http://user:pass@host1:port,http://host2:port
PROXY_SERVER=
