# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=directLink

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Chrome real = TLS/HTTP fingerprint melhor. Vazio = autodetect, senão Chromium do Puppeteer
CHROME_AUTODETECT=true
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=60000
DEFAULT_TIMEOUT_MS=30000

# Intervalo entre visitas (segundos). 0 = usa STEALTH_GAP_* (padrão humano)
INTERVAL_MIN_SEC=0
INTERVAL_MAX_SEC=0

# Reinicia o browser a cada N iterações (0 = nunca)
BROWSER_RESTART_EVERY=0

# Viewport fallback (o perfil stealth sobrescreve)
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Direct link — separe múltiplas URLs por vírgula
TARGET_URLS=
# 0 = 1 clique; N > 0 = aleatório entre 1 e N
MAX_CLICKS_PER_PAGE=0
INCLUDE_REFERRER=true

# Stealth (navegador menos detectável como bot)
STEALTH=true
HUMANIZE=true
# false = cada visita é um visitante novo (contexto anônimo + cookies zerados)
# true  = um único usuário persistente (debug)
SESSION_PERSIST=false
SESSION_DIR=logs/browser-session
STEALTH_LOCALE=pt-BR
STEALTH_TIMEZONE=America/Sao_Paulo
STEALTH_GAP_MIN_MS=4000
STEALTH_GAP_MAX_MS=22000
DWELL_MIN_MS=900
DWELL_MAX_MS=4200
GEO_LAT=-23.5505
GEO_LON=-46.6333

# Proxies — reputação de IP. Sem persistência, a lista rotaciona a cada visitante
PROXY_ENABLED=false
# PROXY_SERVER=http://user:pass@host:port
# PROXY_SERVERS=http://user:pass@host1:port,http://host2:port
PROXY_SERVER=
# Opção B — até 10 proxies (CSV). Formatos:
#   http://user:pass@host:port
#   host:port:user:pass
# PROXY_LIST=1.2.3.4:80:user:pass,5.6.7.8:80:user:pass
PROXY_LIST=

# ── Ofuscação (visita humana) — docs/11-ofuscacao.md ──
# Alinha timezone/locale à região do IP (proxy.host ou egress). Default: ligado.
STEALTH_GEO_TZ=true
# Fallback quando STEALTH_GEO_TZ=false ou lookup geo falhar:
STEALTH_TIMEZONE=America/Sao_Paulo
STEALTH_LOCALE=pt-BR

# ── Dashboard UI ──
# npm run dashboard → http://127.0.0.1:3847
# Dashboard — em Docker use 0.0.0.0 (compose também força isso)
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_TOKEN=

# ── PostgreSQL (histórico de runs / logs / snapshots) ──
# No Docker Compose o serviço "db" sobe com volume persistente.
# Defina POSTGRES_PASSWORD no seu .env local (nunca commite senhas reais).
POSTGRES_DB=botvisitas
POSTGRES_USER=botvisitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Local (npm run dashboard): preencha com user/senha/db do .env.
# Formato: postgres://USER:PASSWORD@127.0.0.1:5432/DB
# No container o compose monta DATABASE_URL apontando para o host "db".
DATABASE_URL=
# Intervalo dos snapshots de métricas enquanto o bot está running
SNAPSHOT_INTERVAL_SEC=10
