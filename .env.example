# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=directLink

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Chrome/Chromium do sistema (vazio = Chromium do Puppeteer)
# No Docker o compose força /usr/bin/chromium automaticamente.
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=60000
DEFAULT_TIMEOUT_MS=30000

# Ritmo entre visitas (segundos). Ex.: 5–12 = rápido; 0–0 = sem pausa
INTERVAL_MIN_SEC=5
INTERVAL_MAX_SEC=12

# Reinicia o browser a cada N iterações (0 = nunca) — libera proxy e pega outro do pool
BROWSER_RESTART_EVERY=10

# Direct link — visita a URL (páginas extras gastam banda do proxy)
TARGET_URLS=
BROWSE_PAGES_MIN=0
BROWSE_PAGES_MAX=0
INCLUDE_REFERRER=false
# Engajamento CTR/CPM — cliques reais + hover + scroll na landing
ENGAGE_ENABLED=true
ENGAGE_CLICKS_MIN=1
ENGAGE_CLICKS_MAX=1
MAX_CLICKS_PER_PAGE=1
# Opcional: força 1º clique neste seletor CSS (aspas se começar com #)
CLICK_SELECTOR=

# Economia de banda do proxy: off | light | aggressive
# light = bloqueia vídeo/fontes; aggressive = ainda bloqueia vídeo/fontes/other (mantém image+CSS p/ CTR)
# light = vídeo/fontes | aggressive = +CSS/imagens (economiza MB; pode afetar CTA/pixels)
BANDWIDTH_SAVER=light

# Workers: cada um baixa a página inteira via proxy — 10 workers queima GB rápido
# Com PROXY_ENABLED: teto = tamanho do pool (máx. 40)
CONCURRENCY=40
DEVICE_MIX=desktop:20,mobile:20
# Painel: 1 worker = device + país. Manda sobre DEVICE_MIX quando preenchido.
# WORKER_SLOTS=mobile:au,desktop:de,mobile:us

# Viewport fallback
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Proxies — Webshare (máx. 40). Credenciais só no .env (nunca no Git).
PROXY_ENABLED=false
PROXY_MAX=40
PROXY_ROTATE=roundRobin
# true = não envia visita por IP marcado proxy/hosting (evita "anonymous proxy detected")
PROXY_SKIP_FLAGGED=true
# se o pool inteiro for anon/datacenter, visita sem proxy em vez de queimar o alvo
PROXY_FALLBACK_DIRECT=true
# Opção A — gateway único:
# PROXY_SERVER=http://USER:PASS@p.webshare.io:80
PROXY_SERVER=
# Opção B — CSV. Formatos: http://user:pass@host:port  OU  host:port:user:pass
PROXY_LIST=

# Países de saída (ISO-2) — DataImpulse __cr.us etc. Vazio = qualquer país do pool
# Tier-1 CPM comum: us,gb,ca,au,de,nl,ch
PROXY_COUNTRIES=au,de,us

# Ofuscação — timezone/locale pela região do IP
STEALTH_GEO_TZ=true
STEALTH_TIMEZONE=America/Sao_Paulo
STEALTH_LOCALE=pt-BR

# Dashboard — npm run dashboard → http://127.0.0.1:3847
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_TOKEN=

# Sandbox Compose (testpage). 0 = Docker escolhe uma porta livre no host
# se 3000 já estiver em uso. O bot usa http://testpage:3000 na rede interna.
TESTPAGE_PORT=0

# PostgreSQL (histórico). Não commite senhas reais.
POSTGRES_DB=botvisitas
POSTGRES_USER=botvisitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
SNAPSHOT_INTERVAL_SEC=30
