# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=dryRun

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Opcional: Chrome/Chromium do sistema (deixe vazio = Chromium do Puppeteer)
# No Docker o compose força /usr/bin/chromium automaticamente.
# Exemplos (host):
# CHROME_EXECUTABLE_PATH=/usr/bin/chromium
# CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome
CHROME_EXECUTABLE_PATH=

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=60000
DEFAULT_TIMEOUT_MS=30000

# Intervalo entre iterações (segundos)
INTERVAL_MIN_SEC=60
INTERVAL_MAX_SEC=900

# Reinicia o browser a cada N iterações (0 = nunca)
BROWSER_RESTART_EVERY=20

# Viewport
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Direct link (só usado se STRATEGY=directLink)
# AVISO: TARGET_URLS deve apontar SÓ para infra que você controla.
# Separe múltiplas URLs por vírgula
TARGET_URLS=
MAX_CLICKS_PER_PAGE=15
INCLUDE_REFERRER=true
# Clica um elemento específico (CSS selector). Vazio = clique no centro da viewport.
# ATENÇÃO: selector iniciado por "#" PRECISA de aspas, senão o dotenv o trata
# como comentário e o valor vira vazio.
# Ex.: CLICK_SELECTOR="#comprar"  |  CLICK_SELECTOR=.btn-cta
CLICK_SELECTOR=
# Allow-list de hosts p/ a directLink (CSV). Vazio = sem restrição.
# Ex.: TARGET_ALLOW_HOSTS=staging.local,127.0.0.1
TARGET_ALLOW_HOSTS=

# Receita p/ testar SUA página:
#   STRATEGY=directLink
#   TARGET_URLS=https://staging.seudominio/pagina   (ou file:///caminho/test.html)
#   CLICK_SELECTOR="#seu-botao"   (aspas se começar com "#")
#   INCLUDE_REFERRER=false
#   INTERVAL_MIN_SEC=2  INTERVAL_MAX_SEC=5   (ciclos rápidos durante o teste)

# Proxies — preparados, desligados por enquanto
PROXY_ENABLED=false
# PROXY_SERVER=http://user:pass@host:port
PROXY_SERVER=

# ── Red-Team Detection-Coverage Harness (npm run redteam) ──
# Uso autorizado apenas, contra infra que VOCÊ controla. Mede cobertura de
# detecção; não torna nada indetectável. Default = coletor local em 127.0.0.1.

# Sessões por nível de sofisticação
REDTEAM_SESSIONS_PER_LEVEL=3
# Subconjunto de níveis (vazio = todos). Ex.: L0,L2,L3
REDTEAM_LEVELS=
# Porta do coletor local (0 = porta automática)
REDTEAM_PORT=0
# Alvo externo (opcional). Deve ser infra sua e host precisa estar na allow-list.
# Vazio = usa o coletor local embutido.
REDTEAM_TARGET_URL=
# Hosts extra permitidos além de localhost/127.0.0.1/::1 (separados por vírgula)
REDTEAM_ALLOW_HOSTS=
