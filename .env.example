# Copie para .env e ajuste. Nunca commite o .env.

# dryRun | directLink
STRATEGY=directLink

# true = Chromium sem janela (recomendado em servers)
HEADLESS=true

# Chrome/Chromium do sistema (vazio = Chromium do Puppeteer)
# No Docker o compose força /usr/bin/chromium automaticamente.
CHROME_EXECUTABLE_PATH=/usr/bin/chromium

# Timeouts em ms
NAVIGATION_TIMEOUT_MS=30000
DEFAULT_TIMEOUT_MS=30000

# Ritmo entre visitas (segundos). Ex.: 5–12 = rápido; 0–0 = sem pausa
INTERVAL_MIN_SEC=5
INTERVAL_MAX_SEC=12

# Recicla o Chromium a cada N visitas (0 = nunca). Evita leak de RAM overnight.
BROWSER_RESTART_EVERY=20
CHROME_PROCESS_LIMIT=1
MEMORY_WARN_PCT=0.82
MEMORY_CRITICAL_PCT=0.90

# Links de destino: cole no painel (Operação → Start). Não use TARGET_URLS aqui.
BROWSE_PAGES_MIN=0
BROWSE_PAGES_MAX=0
# true = visita Google/Bing da geo e clica até o smartlink (tráfego não-direct)
INCLUDE_REFERRER=true
# Engajamento CTR/CPM — cliques reais + hover + scroll na landing
ENGAGE_ENABLED=true
ENGAGE_CLICKS_MIN=2
ENGAGE_CLICKS_MAX=4
MAX_CLICKS_PER_PAGE=4
# Opcional: força 1º clique neste seletor CSS (aspas se começar com #)
CLICK_SELECTOR=
# Teto de wall-clock por visita (nav + dwell + engage)
VISIT_MAX_SEC=60
# Retry com outro link se qualidade=intermediate (Google/DuckDuckGo etc.)
VISIT_RETRY_ON_DEAD_END=1
# Limite de tempo do humanEngage por página
ENGAGE_MAX_MS=25000
# hybrid | legacy | engage — hybrid = CTA + fallback centro v1
CLICK_MODE=legacy
# true = só conta clique se URL mudou (mais rigoroso; teste antes de ligar)
ENGAGE_REQUIRE_URL_CHANGE=false

# Economia de banda: off | light | aggressive
BANDWIDTH_SAVER=light

# Workers paralelos — cada um com browser + device próprio (mobile/desktop independentes)
CONCURRENCY=4
DEVICE_MIX=desktop:2,mobile:2
# Painel: 1 slot = device (+ país opcional). Ex.: desktop,mobile,desktop,mobile
# WORKER_SLOTS=desktop,mobile,desktop,mobile
WORKER_STAGGER_MS=800

# Viewport fallback
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# === Egress: TuxlerVPN residencial gratuito (Windows) ===
TUXLER_ENABLED=true
TUXLER_EXE=C:\Program Files (x86)\tuxlerVPN\tuxlerVPN.exe
# vazio = auto-detecta ao lado do TUXLER_EXE (ExtensionHelperAppHelperTuxler.exe)
TUXLER_HELPER_EXE=C:\Program Files (x86)\tuxlerVPN\ExtensionHelperAppHelperTuxler.exe
TUXLER_ROTATE_TIMEOUT_MS=15000
# skip = Tuxler manual (padrão). restart | coords | uia = rotação automática.
TUXLER_ROTATE_MODE=skip
TUXLER_CLICK_X=0.50
TUXLER_CLICK_Y=0.68
# Clique no botao "Activate" apos restart do helper (ajuste se errar o alvo)
TUXLER_ACTIVATE_X=0.50
TUXLER_ACTIVATE_Y=0.58

# Países ISO-2 por worker (WORKER_SLOTS ou ciclo). Tuxler: alvo da rotação PowerShell.
PROXY_COUNTRIES=au,de,us

# Ofuscação — timezone/locale pela região do IP
STEALTH_GEO_TZ=true
# Fallback só se ip-api falhar — com Tuxler o geo real vem do IP da VPN
STEALTH_TIMEZONE=America/Caracas
STEALTH_LOCALE=es-VE

# Dashboard — npm run dashboard → http://127.0.0.1:3847
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3847
DASHBOARD_TOKEN=

# Sandbox Compose (testpage). 0 = Docker escolhe uma porta livre no host
TESTPAGE_PORT=0

# PostgreSQL (histórico). Não commite senhas reais.
POSTGRES_DB=botvisitas
POSTGRES_USER=botvisitas
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
SNAPSHOT_INTERVAL_SEC=30

LOG_LEVEL=info
